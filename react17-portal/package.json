{
  "name": "react17-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5170 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5170 --strictPort",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:watch": "SLOWMO=${SLOWMO:-700} playwright test --headed --workers=1 --reporter=list",
    "build:lib": "node scripts/build-lib.mjs",
    "sync:features": "node scripts/sync-features.mjs",
    "pack:lib": "npm run build:lib && mkdir -p lib-pack && npm pack ./lib-dist --pack-destination lib-pack"
  },
  "dependencies": {
    "@mfe/app19-features": "file:vendor/mfe-app19-features-0.1.0.tgz",
    "@module-federation/runtime": "2.9.3",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@module-federation/vite": "1.24.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "17.0.93",
    "@types/react-dom": "17.0.26",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
